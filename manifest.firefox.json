{
  "manifest_version": 3,
  "name": "Mimir",
  "version": "1.0.0",
  "description": "Cybersecurity toolkit — encoding, CTI, log analysis, redaction, payloads",
  "permissions": ["storage", "contextMenus", "activeTab", "alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mimir"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mimir@extension.local",
      "strict_min_version": "128.0"
    }
  }
}
